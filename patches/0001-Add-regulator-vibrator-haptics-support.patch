--- a/bootable/recovery/minuitwrp/events.cpp
+++ b/bootable/recovery/minuitwrp/events.cpp
@@ -61,6 +61,8 @@
 #define VIBRATOR_TIMEOUT_FILE	"/sys/class/timed_output/vibrator/enable"
 #define VIBRATOR_TIME_MS    50

+#define LEDS_VIBRATOR_BRIGHTNESS_FILE	"/sys/class/leds/vibrator_single/brightness"
+#define LEDS_VIBRATOR_TRIGGER_FILE	"/sys/class/leds/vibrator_single/trigger"

 #define LEDS_HAPTICS_DURATION_FILE	"/sys/class/leds/vibrator_single/duration"
 #define LEDS_HAPTICS_ACTIVATE_FILE	"/sys/class/leds/vibrator_single/activate"
@@ -81,11 +83,29 @@
         write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
     }
 #else
-    if (std::ifstream(LEDS_HAPTICS_ACTIVATE_FILE).good()) {
-        write_to_file(LEDS_HAPTICS_DURATION_FILE, tout);
-        write_to_file(LEDS_HAPTICS_ACTIVATE_FILE, "1");
-    } else
-        write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
+    // Check for regulator-vibrator (brightness control with timer trigger)
+    if (std::ifstream(LEDS_VIBRATOR_BRIGHTNESS_FILE).good()) {
+        // Set trigger to timer mode
+        write_to_file(LEDS_VIBRATOR_TRIGGER_FILE, "timer");
+
+        // Use fixed brightness (80% of max=255 for good feel)
+        write_to_file(LEDS_VIBRATOR_BRIGHTNESS_FILE, "200");
+
+        // Wait for vibration duration
+        usleep(timeout_ms * 1000);
+
+        // Stop vibration
+        write_to_file(LEDS_VIBRATOR_BRIGHTNESS_FILE, "0");
+
+        // Reset trigger to none
+        write_to_file(LEDS_VIBRATOR_TRIGGER_FILE, "none");
+
+    } else if (std::ifstream(LEDS_HAPTICS_ACTIVATE_FILE).good()) {
+        write_to_file(LEDS_HAPTICS_DURATION_FILE, tout);
+        write_to_file(LEDS_HAPTICS_ACTIVATE_FILE, "1");
+    } else {
+        write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
+    }
 #endif
     return 0;
 }
